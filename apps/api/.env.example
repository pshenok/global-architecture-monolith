# Local development values (copy to .env; pnpm db:setup does). Validated at boot by src/config.ts.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
HTTP_HOST=127.0.0.1
HTTP_PORT=9443
TLS_ENABLED=true
TLS_CERT_FILE=../../.certs/dev-cert.pem
TLS_KEY_FILE=../../.certs/dev-key.pem
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
# Proxies whose X-Forwarded-For to trust (addresses or CIDRs, comma-separated); false = none.
# The rate limit keys on the client address, so set it behind a load balancer.
TRUST_PROXY=false
# Deadline per request, upload and handler included (answers 504 when it passes)
REQUEST_TIMEOUT_MS=30000
# /docs and /openapi.json; defaults to off when NODE_ENV=production
DOCS_ENABLED=true
# The one database every module keeps its schema in (pnpm db:setup creates it)
DATABASE_URL=postgresql://gam:gam@localhost:5432/gam
# Trusted identity providers (JSON array). Locally: the stack's dev IdP (tools/dev-idp.ts).
AUTH_ISSUERS=[{"issuer":"http://127.0.0.1:9090","audience":"gam-api","jwksUri":"http://127.0.0.1:9090/jwks.json","userinfoUri":"http://127.0.0.1:9090/userinfo"}]
AUTH_JWKS_UNKNOWN_KID_COOLDOWN_S=1
