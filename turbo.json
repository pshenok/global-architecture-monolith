{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".swcrc", "vitest.shared.ts", ".oxlintrc.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!test/**", "!README.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "test": {
      "env": ["TEST_DATABASE_URL", "LOG_LEVEL"],
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  }
}
